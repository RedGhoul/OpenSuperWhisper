<Window x:Class="OpenSuperWhisper.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenSuperWhisper Settings"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="620" Height="720" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6B6B6B" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,6,20,20">

            <TextBlock Style="{StaticResource Section}" Text="Model" />
            <ItemsControl x:Name="ModelList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#FFDDDDDD" BorderThickness="0,0,0,1" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <RadioButton GroupName="Model" VerticalAlignment="Center"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             IsEnabled="{Binding IsDownloaded}" />
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock>
                                        <Run Text="{Binding Model.DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Model.Size, Mode=OneWay}" Foreground="#FF6B6B6B" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Model.Description}" Foreground="#FF6B6B6B" TextWrapping="Wrap" />
                                    <ProgressBar Height="4" Margin="0,4,0,0" Maximum="1"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 Visibility="{Binding ProgressVisibility}" />
                                </StackPanel>
                                <Button Grid.Column="2" MinWidth="90" Padding="10,3" VerticalAlignment="Center"
                                        Content="{Binding ActionLabel}" Click="OnModelAction"
                                        Visibility="{Binding ActionVisibility}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Hint}">
                Models are stored in <Hyperlink x:Name="ModelsFolderLink" Click="OnOpenModelsFolder">your app data folder</Hyperlink>.
            </TextBlock>

            <TextBlock Style="{StaticResource Section}" Text="GPU" />
            <ComboBox x:Name="BackendBox" SelectionChanged="OnBackendChanged" Width="260" HorizontalAlignment="Left">
                <ComboBoxItem Tag="Auto" Content="Automatic (CUDA → Vulkan → CPU)" />
                <ComboBoxItem Tag="Cuda" Content="NVIDIA CUDA" />
                <ComboBoxItem Tag="Vulkan" Content="Vulkan (NVIDIA, AMD, Intel)" />
                <ComboBoxItem Tag="Cpu" Content="CPU only" />
            </ComboBox>
            <TextBlock x:Name="BackendStatus" Style="{StaticResource Hint}" />

            <TextBlock Style="{StaticResource Section}" Text="Language" />
            <ComboBox x:Name="LanguageBox" SelectionChanged="OnLanguageChanged" Width="260" HorizontalAlignment="Left"
                      DisplayMemberPath="Value" SelectedValuePath="Key" />
            <TextBlock x:Name="LanguageHint" Style="{StaticResource Hint}"
                       Text="The selected model is English-only, so this setting is ignored." />

            <TextBlock Style="{StaticResource Section}" Text="Microphone" />
            <ComboBox x:Name="MicrophoneBox" SelectionChanged="OnMicrophoneChanged" Width="360" HorizontalAlignment="Left"
                      DisplayMemberPath="Name" SelectedValuePath="DeviceNumber" />

            <TextBlock Style="{StaticResource Section}" Text="Shortcut" />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="HotkeyBox" Width="220" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         PreviewKeyDown="OnHotkeyKeyDown" GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur"
                         Padding="4,3" Cursor="Hand" />
                <Button Content="Reset" Margin="8,0,0,0" Padding="10,3" Click="OnHotkeyReset" />
            </StackPanel>
            <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}"
                       Text="Click the box, then press the new combination. Press Esc while recording to cancel." />
            <CheckBox x:Name="HoldToRecordBox" Margin="0,10,0,0" Click="OnOptionChanged"
                      Content="Hold to record (release to transcribe). Off: press once to start, again to stop." />

            <TextBlock Style="{StaticResource Section}" Text="Output" />
            <CheckBox x:Name="AutoPasteBox" Click="OnOptionChanged"
                      Content="Paste into the focused app (otherwise only copy to the clipboard)" />
            <CheckBox x:Name="TrailingSpaceBox" Margin="0,6,0,0" Click="OnOptionChanged"
                      Content="Add a space after the text" />
            <TextBlock Text="Initial prompt (names, jargon, punctuation style):" Margin="0,12,0,4" />
            <TextBox x:Name="PromptBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" LostFocus="OnPromptChanged" />

            <TextBlock Style="{StaticResource Hint}" Margin="0,20,0,0">
                <Hyperlink Click="OnOpenLog">Open log file</Hyperlink>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</Window>
