<Window x:Class="OpenSuperWhisper.Views.IndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenSuperWhisper"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        SizeToContent="WidthAndHeight">
    <Border CornerRadius="18" Background="#E6202124" Padding="14,8" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#FFEA4335" VerticalAlignment="Center" />
            <!-- Mic level: fixed track, the fill width follows the input peak. -->
            <Grid x:Name="LevelTrack" Width="48" Height="6" Margin="10,0,0,0" VerticalAlignment="Center">
                <Border CornerRadius="3" Background="#33FFFFFF" />
                <Border x:Name="LevelFill" CornerRadius="3" Background="#FFFFFFFF" HorizontalAlignment="Left" Width="0" />
            </Grid>
            <TextBlock x:Name="Label" Margin="10,0,0,0" Foreground="White" FontSize="13" VerticalAlignment="Center"
                       Text="Listening" />
        </StackPanel>
    </Border>
</Window>
